{
  "name": "mmdash",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm build:ts && pnpm build:go && pnpm build:python",
    "build:ts": "pnpm -r --if-present build",
    "build:go": "go build ./backend/... ./box/... ./clients/cli/...",
    "build:python": "uv build --package mmdash-worker",
    "test": "pnpm test:ts && pnpm test:go && pnpm test:python",
    "test:ts": "vitest run scripts --exclude \".claude/**\" --exclude \".cache/**\" --exclude \".worktrees/**\" --exclude \".pnpm-store/**\" && pnpm -r --if-present test",
    "test:core": "go test ./backend/...",
    "test:go": "go test ./backend/... ./box/... ./clients/cli/...",
    "test:python": "uv run --package mmdash-worker pytest",
    "lint": "pnpm lint:ts && pnpm lint:go && pnpm lint:python",
    "lint:ts": "eslint .",
    "lint:go": "node scripts/check-go-format.mjs",
    "lint:python": "uv run --package mmdash-worker ruff check workers",
    "format": "prettier --write . && gofmt -w backend clients/cli && uv run --package mmdash-worker ruff format workers",
    "format:check": "prettier --check . && node scripts/check-go-format.mjs && uv run --package mmdash-worker ruff format --check workers",
    "check": "pnpm lint && pnpm test && pnpm build && pnpm contracts:check && pnpm api:check && pnpm caddy:check",
    "api:check": "node scripts/check-api-docs.mjs",
    "caddy:check": "node scripts/check-caddyfile.mjs",
    "contracts:baseline": "node scripts/check-contract-compat.mjs --write",
    "contracts:check": "node scripts/check-contracts.mjs && node scripts/check-contract-compat.mjs",
    "contracts:generate": "pnpm --filter @mmdash/core-client generate && node scripts/generate-contracts.mjs",
    "contract:mock": "node scripts/contract-mock.mjs",
    "commit:check": "node scripts/check-commit-message.mjs",
    "dev": "docker compose -f deploy/compose/compose.yaml up --build",
    "dev:down": "docker compose -f deploy/compose/compose.yaml down",
    "migrate": "go run ./backend/cmd/migrate",
    "smoke": "node scripts/smoke.mjs",
    "smoke:article-worker": "node scripts/article-worker-smoke.mjs",
    "smoke:artifact-preview": "node scripts/artifact-preview-smoke.mjs",
    "scaffold:module": "node scripts/create-module.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@types/node": "^24.1.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "eslint": "^9.32.0",
    "globals": "^16.3.0",
    "js-yaml": "^4.2.0",
    "prettier": "^3.6.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0",
    "vitest": "^3.2.4"
  }
}
