{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mmdash.moe/contracts/manifest.schema.json",
  "title": "mmdash experiment result manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "experiment_id",
    "source_commit",
    "result_directory",
    "status",
    "started_at",
    "finished_at",
    "runtime",
    "runtime_version",
    "logs_truncated",
    "files"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "2" },
    "experiment_id": { "type": "string", "format": "uuid" },
    "source_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"
    },
    "result_directory": {
      "type": "string",
      "pattern": "^experiments/[0-9a-f-]+_[0-9]{8}_[0-9]{4}/$",
      "maxLength": 4096
    },
    "status": {
      "type": "string",
      "enum": ["succeeded", "failed", "canceled", "timed_out"]
    },
    "started_at": { "type": "string", "format": "date-time" },
    "finished_at": { "type": "string", "format": "date-time" },
    "runtime": { "type": "string", "enum": ["local-docker", "e2b"] },
    "runtime_version": { "type": "string", "minLength": 1, "maxLength": 100 },
    "logs_truncated": { "type": "boolean" },
    "summary": { "type": "string", "maxLength": 20000 },
    "exit_code": { "type": "integer", "minimum": -255, "maximum": 255 },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "environment_key",
        "base_image_id",
        "environment_image_id",
        "manifest_paths",
        "manifest_hashes",
        "builder_version",
        "cache_hit"
      ],
      "properties": {
        "environment_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "base_image_id": { "type": "string", "minLength": 1, "maxLength": 512 },
        "environment_image_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "manifest_paths": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?/)(?!.*(?:^|/)\\.\\.\\s*$)[^\\x00]+$",
            "maxLength": 4096
          }
        },
        "manifest_hashes": {
          "type": "object",
          "maxProperties": 32,
          "additionalProperties": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "builder_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "cache_hit": { "type": "boolean" }
      }
    },
    "files": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "size_bytes", "kind"],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?/)(?!.*(?:^|/)\\.\\.\\s*$)[^\\x00]+$",
            "maxLength": 4096
          },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "size_bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10737418240
          },
          "kind": {
            "type": "string",
            "enum": [
              "file",
              "log",
              "figure",
              "table",
              "data",
              "model",
              "summary"
            ]
          },
          "mime_type": { "type": "string", "maxLength": 200 }
        }
      }
    }
  }
}
