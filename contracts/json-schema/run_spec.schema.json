{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mmdash.moe/contracts/run_spec.schema.json",
  "title": "mmdash frozen experiment run specification",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "experiment_id", "project_id", "source_commit", "entrypoint", "parameters", "environment", "inputs", "runtime", "limits"],
  "properties": {
    "schema_version": { "type": "string", "const": "1" },
    "experiment_id": { "type": "string", "format": "uuid" },
    "project_id": { "type": "string", "format": "uuid" },
    "source_commit": { "type": "string", "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$" },
    "entrypoint": { "type": "string", "pattern": "^(python3?|node|go|binary):[a-zA-Z0-9_./-]+$", "maxLength": 500 },
    "parameters": { "type": "object", "additionalProperties": true },
    "environment": { "type": "object", "additionalProperties": { "type": "string" }, "maxProperties": 100 },
    "inputs": { "type": "object", "additionalProperties": true },
    "runtime": { "type": "string", "enum": ["local-docker", "e2b"] },
    "limits": { "$ref": "https://mmdash.moe/contracts/box.schema.json#/$defs/resource_limits" },
    "readonly_credentials": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "value_ref"],
        "properties": {
          "name": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,63}$" },
          "value_ref": { "type": "string", "maxLength": 200 }
        }
      }
    }
  }
}
