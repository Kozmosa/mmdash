{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mmdash.moe/schemas/mcp-tools/artifact.upload.json",
  "title": "artifact.upload MCP tool",
  "description": "Creates an Agent Artifact through short-lived direct multipart object-storage grants without carrying file bytes through MCP, Gateway, or Core.",
  "x-operation-id": "artifact.upload",
  "$defs": {
    "project_id": { "type": "string", "format": "uuid" },
    "upload_id": { "type": "string", "format": "uuid" },
    "part_numbers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "uniqueItems": true,
      "items": { "type": "integer", "minimum": 1, "maximum": 10000 }
    },
    "input": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "dependentRequired": {
            "agent_session_id": ["agent_run_id"],
            "agent_run_id": ["agent_session_id"]
          },
          "required": [
            "action",
            "project_id",
            "filename",
            "size_bytes",
            "sha256",
            "idempotency_key"
          ],
          "properties": {
            "action": { "const": "begin" },
            "project_id": { "$ref": "#/$defs/project_id" },
            "agent_session_id": { "type": "string", "format": "uuid" },
            "agent_run_id": { "type": "string", "format": "uuid" },
            "filename": { "type": "string", "minLength": 1, "maxLength": 255 },
            "name": { "type": "string", "minLength": 1, "maxLength": 255 },
            "size_bytes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "mime_type": { "type": "string", "minLength": 1, "maxLength": 255 },
            "tags": {
              "type": "array",
              "maxItems": 32,
              "items": { "type": "string", "minLength": 1, "maxLength": 64 }
            },
            "description": { "type": "string", "maxLength": 4000 },
            "idempotency_key": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "part_numbers": { "$ref": "#/$defs/part_numbers" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["action", "project_id", "upload_id", "part_numbers"],
          "properties": {
            "action": { "const": "parts" },
            "project_id": { "$ref": "#/$defs/project_id" },
            "upload_id": { "$ref": "#/$defs/upload_id" },
            "part_numbers": { "$ref": "#/$defs/part_numbers" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["action", "project_id", "upload_id", "parts"],
          "properties": {
            "action": { "const": "complete" },
            "project_id": { "$ref": "#/$defs/project_id" },
            "upload_id": { "$ref": "#/$defs/upload_id" },
            "parts": {
              "type": "array",
              "minItems": 1,
              "maxItems": 10000,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["part_number", "etag"],
                "properties": {
                  "part_number": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 10000
                  },
                  "etag": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2048
                  }
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["action", "project_id", "upload_id"],
          "properties": {
            "action": { "const": "abort" },
            "project_id": { "$ref": "#/$defs/project_id" },
            "upload_id": { "$ref": "#/$defs/upload_id" }
          }
        }
      ]
    },
    "output": {
      "type": "object",
      "additionalProperties": true,
      "description": "Upload state, direct part grants, completed Artifact detail, or abort acknowledgement for the selected action."
    }
  }
}
