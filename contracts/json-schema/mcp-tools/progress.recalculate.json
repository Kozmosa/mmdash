{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mmdash.moe/schemas/mcp-tools/progress.recalculate.json",
  "title": "progress.recalculate MCP tool",
  "description": "Schedules a debounced and idempotent automatic Progress evaluation.",
  "x-operation-id": "progress.recalculate",
  "$defs": {
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project_id"],
      "properties": {
        "project_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{1,127}$"
        },
        "trigger_kind": {
          "type": "string",
          "enum": ["manual", "cron"],
          "default": "manual"
        },
        "force": { "type": "boolean", "default": false }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request_id", "status", "scheduled_for", "merged"],
      "properties": {
        "request_id": { "type": "string", "format": "uuid" },
        "status": { "type": "string", "const": "pending" },
        "scheduled_for": { "type": "string", "format": "date-time" },
        "merged": { "type": "boolean" }
      }
    }
  }
}
