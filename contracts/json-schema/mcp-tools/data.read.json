{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mmdash.com/schemas/mcp-tools/data.read.json",
  "title": "data.read MCP tool",
  "description": "Reads an authorized Data Hub object through its authoritative module adapter.",
  "x-operation-id": "data.read",
  "$defs": {
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project_id", "object_id"],
      "properties": {
        "project_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{1,127}$"
        },
        "object_id": {
          "type": "string",
          "format": "uuid"
        }
      }
    },
    "output": {
      "type": "object",
      "required": ["object", "content"],
      "properties": {
        "object": {
          "type": "object"
        },
        "content": {}
      }
    }
  }
}
