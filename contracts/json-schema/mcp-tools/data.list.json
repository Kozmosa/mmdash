{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mmdash.com/schemas/mcp-tools/data.list.json",
  "title": "data.list MCP tool",
  "description": "Lists authorized Data Hub projections without reading module storage directly.",
  "x-operation-id": "data.list",
  "$defs": {
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project_id"],
      "properties": {
        "project_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{1,127}$"
        },
        "type": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,99}$"
        },
        "cursor": {
          "type": "string",
          "maxLength": 4096
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200
        }
      }
    },
    "output": {
      "type": "object",
      "required": ["items", "has_more"],
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "has_more": {
          "type": "boolean"
        },
        "next_cursor": {
          "type": "string"
        }
      }
    }
  }
}
