{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mmdash.moe/contracts/json-schema/article-template.schema.json",
  "title": "mmdash Article Template Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "name",
    "version",
    "entrypoint",
    "output",
    "content_target",
    "bibliography_target",
    "engine",
    "bibliography_tool"
  ],
  "properties": {
    "schema_version": { "enum": ["1.0", "1.1"] },
    "name": { "type": "string", "minLength": 1, "maxLength": 120 },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"
    },
    "entrypoint": { "$ref": "#/$defs/relativeTexPath" },
    "output": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*\\.pdf$",
      "maxLength": 255
    },
    "content_target": { "$ref": "#/$defs/relativeTexPath" },
    "bibliography_target": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[A-Za-z0-9._/-]+\\.bib$",
      "maxLength": 255
    },
    "engine": { "enum": ["auto", "pdflatex", "xelatex", "lualatex"] },
    "bibliography_tool": { "enum": ["auto", "bibtex", "biber", "none"] },
    "abstract_target": { "$ref": "#/$defs/relativeTexPath" },
    "body_layout": { "enum": ["single", "sections"] },
    "field_profile": { "enum": ["default", "cumcm"] },
    "figure_dir": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[A-Za-z0-9._/-]+$",
      "maxLength": 120
    },
    "bibliography_mode": { "enum": ["inline", "native"] }
  },
  "$defs": {
    "relativeTexPath": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[A-Za-z0-9._/-]+\\.tex$",
      "maxLength": 255
    }
  }
}
