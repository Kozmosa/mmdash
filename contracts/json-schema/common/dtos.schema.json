{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mmdash.moe/schemas/common/dtos.schema.json",
  "title": "mmdash common DTOs",
  "$defs": {
    "Identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "Timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "RequestId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{7,127}$"
    },
    "Error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "request_id": {
          "$ref": "#/$defs/RequestId"
        },
        "details": true
      }
    },
    "CursorPage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["has_more"],
      "properties": {
        "has_more": {
          "type": "boolean"
        },
        "next_cursor": {
          "type": ["string", "null"]
        }
      }
    },
    "Actor": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    }
  }
}
