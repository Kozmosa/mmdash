{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mmdash.moe/contracts/box.schema.json",
  "title": "mmdash Box capability and resource contracts",
  "type": "object",
  "additionalProperties": false,
  "properties": {},
  "$defs": {
    "resource_limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cpu_millis", "memory_bytes", "timeout_seconds", "disk_bytes", "pids", "network"],
      "properties": {
        "cpu_millis": { "type": "integer", "minimum": 1, "maximum": 100000 },
        "memory_bytes": { "type": "integer", "minimum": 1048576, "maximum": 1099511627776 },
        "timeout_seconds": { "type": "integer", "minimum": 1, "maximum": 86400 },
        "disk_bytes": { "type": "integer", "minimum": 1048576, "maximum": 1099511627776 },
        "pids": { "type": "integer", "minimum": 1, "maximum": 100000 },
        "network": { "type": "string", "enum": ["disabled", "restricted", "enabled"] }
      }
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z][a-z0-9._-]*$" },
        "version": { "type": "string", "maxLength": 100 },
        "features": { "type": "array", "maxItems": 100, "items": { "type": "string", "maxLength": 100 } }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string", "enum": ["local-docker", "e2b"] },
        "version": { "type": "string", "maxLength": 100 },
        "image": { "type": "string", "maxLength": 255 }
      }
    }
  }
}
