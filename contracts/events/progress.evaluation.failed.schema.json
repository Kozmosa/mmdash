{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mmdash.dev/contracts/events/progress.evaluation.failed.schema.json",
  "title": "progress.evaluation.failed payload",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "resource_id",
    "resource_type",
    "title",
    "status",
    "error_code",
    "attempts"
  ],
  "properties": {
    "resource_id": { "type": "string", "format": "uuid" },
    "resource_type": { "const": "progress_evaluation" },
    "title": { "type": "string", "minLength": 1 },
    "status": { "const": "failed" },
    "error_code": { "type": "string" },
    "attempts": { "type": "integer", "minimum": 0 }
  }
}
