{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mmdash.dev/contracts/events/progress.settings.updated.schema.json",
  "title": "progress.settings.updated payload",
  "type": "object",
  "additionalProperties": false,
  "required": ["resource_id", "resource_type", "auto_task_changes", "auto_tracking_enabled", "event_triggers_enabled", "cron_enabled", "cron_schedule", "debounce_seconds", "min_interval_seconds", "reasoning_effort"],
  "properties": {
    "resource_id": { "type": "string", "format": "uuid" },
    "resource_type": { "const": "progress_settings" },
    "auto_task_changes": { "type": "boolean" },
    "auto_tracking_enabled": { "type": "boolean" },
    "event_triggers_enabled": { "type": "boolean" },
    "cron_enabled": { "type": "boolean" },
    "cron_schedule": { "type": "string", "minLength": 1, "maxLength": 100 },
    "debounce_seconds": { "type": "integer", "minimum": 0, "maximum": 3600 },
    "min_interval_seconds": { "type": "integer", "minimum": 0, "maximum": 86400 },
    "reasoning_effort": { "type": "string", "enum": ["none", "minimal", "low", "medium", "high", "xhigh", "max", "ultra"] },
    "agent_instance_id": { "type": "string", "format": "uuid" }
  }
}
