{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mmdash.dev/contracts/events/agent.token.issued.schema.json",
  "title": "agent.token.issued payload",
  "type": "object",
  "additionalProperties": false,
  "required": ["project_id", "resource_id", "rotation_id", "status"],
  "properties": {
    "project_id": { "type": "string", "format": "uuid" },
    "resource_id": { "type": "string", "format": "uuid" },
    "rotation_id": { "type": "string", "format": "uuid" },
    "status": {
      "type": "string",
      "enum": ["awaiting_user", "configuring", "verifying"]
    }
  }
}
