{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mmdash.moe/contracts/events/box.registered.schema.json",
  "title": "box.registered payload",
  "type": "object",
  "additionalProperties": false,
  "required": ["box_id", "owner_user_id", "name", "status", "version"],
  "properties": {
    "box_id": { "type": "string", "format": "uuid" },
    "owner_user_id": { "type": "string", "format": "uuid" },
    "name": { "type": "string", "minLength": 1, "maxLength": 200 },
    "status": { "type": "string", "const": "registering" },
    "version": { "type": "string", "minLength": 1, "maxLength": 100 }
  }
}
