{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mmdash.dev/contracts/events/artifact.created.schema.json",
  "title": "artifact.created payload",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_id",
    "version_id",
    "kind",
    "source",
    "name",
    "filename",
    "sha256",
    "size_bytes",
    "status"
  ],
  "properties": {
    "artifact_id": {
      "type": "string",
      "format": "uuid"
    },
    "version_id": {
      "type": "string",
      "format": "uuid"
    },
    "kind": {
      "type": "string",
      "enum": [
        "problem",
        "attachment",
        "experiment_result",
        "model_file",
        "article_build",
        "other"
      ]
    },
    "source": {
      "type": "string",
      "enum": ["user_upload", "experiment", "model", "article", "system"]
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "filename": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "size_bytes": {
      "type": "integer",
      "minimum": 0
    },
    "status": {
      "type": "string",
      "const": "pending_upload"
    }
  }
}
