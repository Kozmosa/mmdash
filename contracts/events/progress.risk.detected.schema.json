{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mmdash.dev/contracts/events/progress.risk.detected.schema.json",
  "title": "progress.risk.detected payload",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "resource_id",
    "resource_type",
    "title",
    "status",
    "evaluation_id",
    "risk_key",
    "severity"
  ],
  "properties": {
    "resource_id": { "type": "string", "format": "uuid" },
    "resource_type": { "const": "progress_risk" },
    "title": { "type": "string", "minLength": 1 },
    "status": { "const": "open" },
    "evaluation_id": { "type": "string", "format": "uuid" },
    "risk_key": { "type": "string", "minLength": 1 },
    "severity": {
      "type": "string",
      "enum": ["low", "medium", "high", "critical"]
    }
  }
}
