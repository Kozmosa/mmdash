{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mmdash.moe/contracts/events/box.revoked.schema.json",
  "title": "box.revoked payload",
  "type": "object",
  "additionalProperties": false,
  "required": ["box_id", "owner_user_id", "name", "status", "mode", "failed_experiment_count"],
  "properties": {
    "box_id": { "type": "string", "format": "uuid" },
    "owner_user_id": { "type": "string", "format": "uuid" },
    "name": { "type": "string", "minLength": 1, "maxLength": 200 },
    "status": { "type": "string", "enum": ["draining", "revoked"] },
    "mode": { "type": "string", "enum": ["drain", "force"] },
    "failed_experiment_count": { "type": "integer", "minimum": 0 }
  }
}
