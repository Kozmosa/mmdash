{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mmdash.local/contracts/events/model.sync.requested.schema.json",
  "title": "model.sync.requested payload",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "sync_id",
    "source_id",
    "scope",
    "trigger",
    "job_id",
    "requested_at"
  ],
  "properties": {
    "sync_id": { "type": "string", "format": "uuid" },
    "source_id": { "type": "string", "format": "uuid" },
    "question_id": { "type": "string", "format": "uuid" },
    "scope": { "type": "string", "enum": ["source", "question"] },
    "trigger": {
      "type": "string",
      "enum": ["manual", "scheduled", "settings"]
    },
    "job_id": { "type": "string", "format": "uuid" },
    "requested_at": { "type": "string", "format": "date-time" }
  }
}
