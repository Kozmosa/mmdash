{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mmdash.dev/contracts/events/progress.proposal.created.schema.json",
  "title": "progress.proposal.created payload",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "resource_id",
    "resource_type",
    "title",
    "status",
    "proposal_type",
    "source"
  ],
  "properties": {
    "resource_id": { "type": "string", "format": "uuid" },
    "resource_type": { "const": "progress_proposal" },
    "title": { "type": "string", "minLength": 1 },
    "status": { "type": "string" },
    "proposal_type": { "type": "string" },
    "source": { "type": "string" },
    "source_run_id": { "type": "string" },
    "source_evaluation_id": { "type": "string", "format": "uuid" }
  }
}
