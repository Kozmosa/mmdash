{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mmdash.dev/contracts/events/agent.run.completed.schema.json",
  "title": "agent.run.completed payload",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "project_id",
    "resource_id",
    "session_id",
    "status",
    "safe_error_code"
  ],
  "properties": {
    "project_id": { "type": "string", "format": "uuid" },
    "resource_id": { "type": "string", "format": "uuid" },
    "session_id": { "type": "string", "format": "uuid" },
    "status": { "const": "completed" },
    "safe_error_code": { "const": "" },
    "source": {
      "type": "string",
      "enum": ["message", "regenerate", "rerun", "progress_evaluation"]
    },
    "source_run_id": { "type": "string", "format": "uuid" },
    "source_evaluation_id": { "type": "string", "format": "uuid" }
  }
}
