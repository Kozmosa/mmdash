{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mmdash.moe/contracts/events/article.build.completed.schema.json",
  "title": "article.build.completed payload",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "build_id",
    "build_kind",
    "status",
    "template_version_id",
    "output_count"
  ],
  "properties": {
    "build_id": { "type": "string", "format": "uuid" },
    "build_kind": { "enum": ["preview", "formal", "template_test"] },
    "commit_id": { "type": "string", "format": "uuid" },
    "draft_revision": { "type": "integer", "minimum": 1 },
    "template_version_id": { "type": "string", "format": "uuid" },
    "output_count": { "type": "integer", "minimum": 1 },
    "status": { "const": "succeeded" }
  }
}
