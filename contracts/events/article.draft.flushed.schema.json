{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mmdash.moe/contracts/events/article.draft.flushed.schema.json",
  "title": "article.draft.flushed payload",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "draft_revision",
    "state_vector_sha256",
    "block_count",
    "status"
  ],
  "properties": {
    "draft_revision": { "type": "integer", "minimum": 1 },
    "state_vector_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "block_count": { "type": "integer", "minimum": 0 },
    "status": { "const": "synced" }
  }
}
