{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mmdash.dev/contracts/events/progress.evaluation.requested.schema.json",
  "title": "progress.evaluation.requested payload",
  "type": "object",
  "additionalProperties": false,
  "required": ["resource_id", "resource_type", "trigger_kind", "scheduled_for"],
  "properties": {
    "resource_id": { "type": "string", "format": "uuid" },
    "resource_type": { "const": "progress_evaluation" },
    "trigger_kind": { "type": "string", "enum": ["event", "manual", "cron", "retry"] },
    "scheduled_for": { "type": "string", "format": "date-time" }
  }
}
