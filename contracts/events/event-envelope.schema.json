{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mmdash.com/schemas/events/event-envelope.schema.json",
  "title": "mmdash Event Envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "event_type",
    "schema_version",
    "occurred_at",
    "producer",
    "project_id",
    "actor",
    "correlation_id",
    "causation_id",
    "payload"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "event_type": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$"
    },
    "schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "occurred_at": {
      "$ref": "../common/dtos.schema.json#/$defs/Timestamp"
    },
    "producer": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "project_id": {
      "type": ["string", "null"]
    },
    "actor": {
      "anyOf": [
        {
          "$ref": "../common/dtos.schema.json#/$defs/Actor"
        },
        {
          "type": "null"
        }
      ]
    },
    "correlation_id": {
      "type": ["string", "null"]
    },
    "causation_id": {
      "type": ["string", "null"]
    },
    "payload": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
