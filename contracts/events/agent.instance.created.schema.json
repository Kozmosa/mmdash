{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mmdash.dev/contracts/events/agent.instance.created.schema.json",
  "title": "agent.instance.created payload",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "project_id",
    "resource_id",
    "adapter_type",
    "management_mode",
    "status"
  ],
  "properties": {
    "project_id": { "type": "string", "format": "uuid" },
    "resource_id": { "type": "string", "format": "uuid" },
    "adapter_type": { "const": "hermes" },
    "management_mode": { "type": "string", "enum": ["manual", "auto"] },
    "status": {
      "type": "string",
      "enum": ["setup_pending", "configuring", "active", "degraded", "disabled"]
    }
  }
}
