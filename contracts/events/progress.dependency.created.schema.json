{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mmdash.dev/contracts/events/progress.dependency.created.schema.json",
  "title": "progress.dependency.created payload",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "resource_id",
    "resource_type",
    "title",
    "status",
    "task_id",
    "depends_on_task_id"
  ],
  "properties": {
    "resource_id": { "type": "string", "format": "uuid" },
    "resource_type": { "const": "dependency" },
    "title": { "type": "string", "minLength": 1 },
    "status": { "type": "string" },
    "task_id": { "type": "string", "format": "uuid" },
    "depends_on_task_id": { "type": "string", "format": "uuid" }
  }
}
