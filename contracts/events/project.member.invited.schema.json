{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mmdash.dev/contracts/events/project.member.invited.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "project_id",
    "invitation_id",
    "normalized_email",
    "role",
    "invited_by_user_id",
    "expires_at"
  ],
  "properties": {
    "project_id": { "type": "string", "format": "uuid" },
    "invitation_id": { "type": "string", "format": "uuid" },
    "normalized_email": { "type": "string", "format": "email" },
    "role": { "type": "string", "enum": ["maintainer", "editor", "viewer"] },
    "invited_by_user_id": { "type": "string", "format": "uuid" },
    "expires_at": { "type": "string", "format": "date-time" }
  }
}
