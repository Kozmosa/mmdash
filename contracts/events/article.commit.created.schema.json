{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mmdash.moe/contracts/events/article.commit.created.schema.json",
  "title": "article.commit.created payload",
  "type": "object",
  "additionalProperties": false,
  "required": ["commit_id", "commit_sha", "draft_revision", "manuscript_sha256", "status"],
  "properties": {
    "commit_id": { "type": "string", "format": "uuid" },
    "commit_sha": { "type": "string", "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$" },
    "draft_revision": { "type": "integer", "minimum": 1 },
    "manuscript_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "status": { "const": "committed" }
  }
}
