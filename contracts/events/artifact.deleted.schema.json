{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mmdash.dev/contracts/events/artifact.deleted.schema.json",
  "title": "artifact.deleted payload",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifact_id", "current_version_id", "reason", "trashed_at"],
  "properties": {
    "artifact_id": {
      "type": "string",
      "format": "uuid"
    },
    "current_version_id": {
      "type": "string",
      "format": "uuid"
    },
    "reason": {
      "type": "string",
      "const": "trashed"
    },
    "trashed_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
