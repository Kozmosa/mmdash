{
  "jsonSchema": {
    "contracts/events/event-envelope.schema.json": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actor",
        "causation_id",
        "correlation_id",
        "event_id",
        "event_type",
        "occurred_at",
        "payload",
        "producer",
        "project_id",
        "schema_version"
      ],
      "properties": {
        "actor": {
          "anyOf": [
            {
              "$ref": "../common/dtos.schema.json#/$defs/Actor"
            },
            {
              "type": "null"
            }
          ]
        },
        "causation_id": {
          "type": ["string", "null"]
        },
        "correlation_id": {
          "type": ["string", "null"]
        },
        "event_id": {
          "type": "string",
          "format": "uuid"
        },
        "event_type": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9]*)+$"
        },
        "occurred_at": {
          "$ref": "../common/dtos.schema.json#/$defs/Timestamp"
        },
        "payload": {
          "type": "object",
          "additionalProperties": true
        },
        "producer": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "project_id": {
          "type": ["string", "null"]
        },
        "schema_version": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "contracts/json-schema/common/dtos.schema.json": {
      "$defs": {
        "Actor": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "CursorPage": {
          "type": "object",
          "additionalProperties": false,
          "required": ["has_more"],
          "properties": {
            "has_more": {
              "type": "boolean"
            },
            "next_cursor": {
              "type": ["string", "null"]
            }
          }
        },
        "Error": {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message"],
          "properties": {
            "code": {
              "type": "string",
              "minLength": 1
            },
            "details": true,
            "message": {
              "type": "string",
              "minLength": 1
            },
            "request_id": {
              "$ref": "#/$defs/RequestId"
            }
          }
        },
        "Identifier": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "RequestId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{7,127}$"
        },
        "Timestamp": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "contracts/json-schema/mcp-tools/system.echo.json": {
      "$defs": {
        "input": {
          "type": "object",
          "additionalProperties": false,
          "required": ["message", "project_id"],
          "properties": {
            "message": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "project_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{1,127}$"
            }
          }
        },
        "output": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "message",
            "principal_kind",
            "project_id",
            "request_id",
            "session_id"
          ],
          "properties": {
            "message": {
              "type": "string"
            },
            "principal_kind": {
              "type": "string",
              "enum": ["agent", "cli"]
            },
            "project_id": {
              "type": "string"
            },
            "request_id": {
              "type": "string"
            },
            "session_id": {
              "type": "string",
              "format": "uuid"
            }
          }
        }
      }
    }
  },
