# Public origin. Keep these two values aligned with the Cloudflare Tunnel
# public hostname.
MMDASH_PRODUCTION_HOST=prod.mmdash.moe
MMDASH_PUBLIC_URL=https://prod.mmdash.moe
MMDASH_VERSION=0.1.0

# Stable Core-only egress bridge and host-owned Repo proxy. Confirm that the
# subnet does not overlap any host, Docker, VPN, or site network before first
# deployment. The proxy listener binds only the gateway address below.
MMDASH_EGRESS_SUBNET=172.31.240.0/24
MMDASH_EGRESS_GATEWAY=172.31.240.1
REPO_GITHUB_PROXY_URL=http://172.31.240.1:17890
REPO_GITHUB_NO_PROXY=localhost,127.0.0.1,::1

# Image pulls for this Compose project can use the 1ms.run mirror without
# changing the host Docker daemon. Verify mirrored manifests against upstream
# and replace release tags with approved digests for a reproducible deployment.
GO_BASE_IMAGE=docker.1ms.run/golang:1.26-alpine
ALPINE_BASE_IMAGE=docker.1ms.run/alpine:3.20
NODE_BASE_IMAGE=docker.1ms.run/node:24-alpine
PYTHON_BASE_IMAGE=docker.1ms.run/python:3.12.11-slim-bookworm
CADDY_BASE_IMAGE=docker.1ms.run/caddy:2.10-alpine
POSTGRES_IMAGE=docker.1ms.run/postgres:16-alpine

# Pin these runtime images to approved immutable release tags or digests before
# validating the Compose file. Empty values intentionally fail closed.
MINIO_IMAGE=
CLOUDFLARED_IMAGE=

# Cloudflare Zero Trust remotely managed Tunnel token. Do not commit it.
CLOUDFLARE_TUNNEL_TOKEN=

# PostgreSQL. Use URL-safe random values (for example hexadecimal) so the
# password can be copied into DATABASE_URL without URL-encoding surprises.
POSTGRES_DB=mmdash
POSTGRES_USER=mmdash
POSTGRES_PASSWORD=
DATABASE_URL=
DATABASE_MAX_IDLE_CONNS=5
DATABASE_MAX_OPEN_CONNS=20
DATABASE_CONN_MAX_IDLE_TIME=5m
DATABASE_CONN_MAX_LIFETIME=30m

# Initial administrator and stable application secrets. The bootstrap account
# is created only when no user exists; changing these values later does not
# rotate an existing account, JWT key, cookie key, or encrypted Settings data.
AUTH_BOOTSTRAP_EMAIL=admin@example.com
AUTH_BOOTSTRAP_DISPLAY_NAME=mmdash Admin
AUTH_BOOTSTRAP_PASSWORD=
AUTH_JWT_SECRET=
BFF_COOKIE_SECRET=
SETTINGS_ENCRYPTION_KEY=
AUTH_ACCESS_TOKEN_TTL=24h
AUTH_SESSION_TTL=720h

# Bundled MinIO. The current initializer uses these credentials for both
# bucket administration and Core access; see README.md before hardening or
# replacing this service with external S3-compatible storage.
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
# Do not use Caddy-reserved first path segments: api, v1, mcp, or _internal.
OBJECT_STORAGE_BUCKET=mmdash
OBJECT_STORAGE_REGION=us-east-1
ARTIFACT_UPLOAD_MAX_BYTES=10737418240
ARTIFACT_MULTIPART_PART_BYTES=16777216
ARTIFACT_MULTIPART_URL_TTL=15m
CADDY_ARTIFACT_MAX_REQUEST_BODY=64MB
CADDY_API_MAX_REQUEST_BODY=64MB
CADDY_MCP_MAX_REQUEST_BODY=16MB

# Optional integrations. Configure the Notion pair together or leave both
# empty. The redirect URI defaults to MMDASH_PUBLIC_URL plus the callback path.
NOTION_OAUTH_CLIENT_ID=
NOTION_OAUTH_CLIENT_SECRET=
NOTION_OAUTH_REDIRECT_URI=https://prod.mmdash.moe/api/integrations/notion/oauth/callback
MCP_CORE_AUDIT_TOKEN=

# Worker is intentionally an opt-in profile until a Core-issued API token is
# available after first bootstrap.
MMDASH_WORKER_API_TOKEN=
MMDASH_WORKER_ID=mmdash-prod-worker-1
MMDASH_WORKER_LEASE_SECONDS=60
MMDASH_WORKER_POLL_SECONDS=2

# Bounded Docker json-file logs.
MMDASH_LOG_MAX_SIZE=10m
MMDASH_LOG_MAX_FILES=5

# Optional application image overrides. Leave unset to build from this source
# checkout; set immutable references when deploying prebuilt release images.
# MMDASH_CORE_IMAGE=registry.example.com/mmdash/core@sha256:...
# MMDASH_WEB_BFF_IMAGE=registry.example.com/mmdash/web-bff@sha256:...
# MMDASH_WEB_IMAGE=registry.example.com/mmdash/web@sha256:...
# MMDASH_MCP_GATEWAY_IMAGE=registry.example.com/mmdash/mcp-gateway@sha256:...
# MMDASH_WORKER_IMAGE=registry.example.com/mmdash/worker@sha256:...
# MMDASH_CADDY_IMAGE=registry.example.com/mmdash/caddy@sha256:...
