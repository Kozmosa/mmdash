#!/usr/sbin/nft -f

# Install as an included nftables fragment after confirming that the Compose
# bridge uses this exact subnet, gateway, and interface name.
table inet mmdash_mihomo {
  chain input {
    type filter hook input priority filter; policy accept;

    iifname "mmdash-egress" ip saddr 172.31.240.0/24 ip daddr 172.31.240.1 tcp dport 17890 accept
    ip daddr 172.31.240.1 tcp dport 17890 drop
  }
}
