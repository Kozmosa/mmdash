[Unit]
Description=mmdash dedicated Repo egress proxy
Documentation=https://github.com/MetaCubeX/mihomo
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=simple
User=mmdash-mihomo
Group=mmdash-mihomo
UMask=0077
ExecStartPre=/usr/bin/test -d /sys/class/net/mmdash-egress
ExecStart=/usr/local/libexec/mmdash-mihomo -d /var/lib/mmdash-mihomo -f /etc/mmdash-mihomo/config.yaml
ExecStartPost=/usr/bin/curl --fail --silent --show-error --max-time 5 http://127.0.0.1:19090/version
Restart=on-failure
RestartSec=5s
TimeoutStartSec=30s
TimeoutStopSec=30s
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectControlGroups=true
ProtectHome=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ReadWritePaths=/var/lib/mmdash-mihomo
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
