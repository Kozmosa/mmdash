mmdash.moe {
	encode zstd gzip

	log {
		output stdout
		format json
	}

	header {
		-Server
		Permissions-Policy "camera=(), geolocation=(), microphone=()"
		Referrer-Policy "strict-origin-when-cross-origin"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
	}

	route {
		@api path /api/*
		handle @api {
			request_body {
				max_size 512MB
			}
			reverse_proxy web-bff:3001 {
				health_uri /health/live
				health_interval 15s
				health_timeout 3s
				health_fails 3
				health_passes 2
				fail_duration 30s
				lb_try_duration 5s
				flush_interval -1
				stream_close_delay 5m
			}
		}

		@mcp path /mcp /mcp/*
		handle @mcp {
			request_body {
				max_size 16MB
			}
			reverse_proxy mcp-gateway:3002 {
				health_uri /health/live
				health_interval 15s
				health_timeout 3s
				health_fails 3
				health_passes 2
				fail_duration 30s
				lb_try_duration 5s
				flush_interval -1
				stream_close_delay 5m
			}
		}

		@core_api path /v1/*
		handle @core_api {
			request_body {
				max_size 16MB
			}
			reverse_proxy core:8080 {
				health_uri /health/ready
				health_interval 15s
				health_timeout 3s
				health_fails 3
				health_passes 2
				fail_duration 30s
				lb_try_duration 5s
				flush_interval -1
			}
		}

		@box path /box /box/*
		handle @box {
			request_body {
				max_size 2GB
			}
			reverse_proxy core:8080 {
				health_uri /health/ready
				health_interval 15s
				health_timeout 3s
				health_fails 3
				health_passes 2
				fail_duration 30s
				lb_try_duration 5s
				flush_interval -1
				stream_close_delay 5m
			}
		}

		handle {
			reverse_proxy web:3000 {
				health_uri /
				health_interval 15s
				health_timeout 3s
				health_fails 3
				health_passes 2
				fail_duration 30s
				lb_try_duration 5s
			}
		}
	}
}
