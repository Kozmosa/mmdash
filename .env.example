# Public entry point
MMDASH_PUBLIC_URL=https://mmdash.com
MMDASH_URL=https://mmdash.com
MMDASH_LOG_LEVEL=warn
MMDASH_VERSION=0.1.0

# Web
WEB_PORT=3000
NEXT_PUBLIC_BFF_BASE_URL=

# Web BFF
BFF_HOST=0.0.0.0
BFF_PORT=3001
BFF_COOKIE_SECRET=replace-with-at-least-32-random-characters
CORE_BASE_URL=http://core:8080

# MCP Gateway
MCP_GATEWAY_HOST=0.0.0.0
MCP_GATEWAY_PORT=3002
MCP_CLI_TOKEN=replace-with-at-least-32-random-characters
MCP_AGENT_TOKEN=replace-with-another-32-random-characters
MCP_CLI_PROJECTS=*
MCP_CLI_TOOLS=*
MCP_AGENT_PROJECTS=*
MCP_AGENT_TOOLS=*
MCP_ALLOWED_HOSTS=mmdash.com,localhost,127.0.0.1
MCP_ALLOWED_ORIGINS=https://mmdash.com,http://localhost:3002
MCP_SESSION_TTL_MS=1800000
# Optional Core-issued API token used to persist MCP audit events.
MCP_CORE_AUDIT_TOKEN=

# Core and infrastructure
CORE_ADDR=:8080
CORE_OPENAPI_PATH=contracts/openapi/core.yaml
CORE_SHUTDOWN_TIMEOUT=10s
CORE_STARTUP_TIMEOUT=15s
AUTH_JWT_SECRET=replace-with-at-least-32-random-characters
AUTH_SESSION_TTL=24h
SETTINGS_ENCRYPTION_KEY=development-settings-encryption-key-change-me
OUTBOX_POLL_INTERVAL=500ms
OUTBOX_EVENT_LEASE=30s
OUTBOX_DELIVERY_LEASE=30s
OUTBOX_RETRY_DELAY=2s
AUTH_BOOTSTRAP_EMAIL=admin@mmdash.local
AUTH_BOOTSTRAP_DISPLAY_NAME=mmdash Admin
AUTH_BOOTSTRAP_PASSWORD=replace-with-at-least-12-characters
DATABASE_URL=postgres://mmdash:mmdash@postgres:5432/mmdash?sslmode=disable
DATABASE_MAX_IDLE_CONNS=5
DATABASE_MAX_OPEN_CONNS=20
DATABASE_CONN_MAX_IDLE_TIME=5m
DATABASE_CONN_MAX_LIFETIME=30m
OBJECT_STORAGE_ENDPOINT=http://minio:9000
OBJECT_STORAGE_ACCESS_KEY=mmdash
OBJECT_STORAGE_SECRET_KEY=change-me
OBJECT_STORAGE_BUCKET=mmdash
REPO_STORAGE_ROOT=/var/lib/mmdash/repos
# Semicolon-separated on Windows, colon-separated on Linux; empty disables Local Git.
REPO_LOCAL_ALLOWED_ROOTS=
REPO_MAX_CONCURRENT_GIT=4
REPO_COMMAND_TIMEOUT=2m
REPO_CLONE_TIMEOUT=15m
REPO_SYNC_POLL_INTERVAL=2s
REPO_SYNC_LEASE=20m
REPO_CHECKOUT_TTL=1h
REPO_MAX_TEXT_BYTES=1048576
REPO_DISCONNECT_GRACE=24h
REPO_ASKPASS_PATH=mmdash-git-askpass

# Python Worker (issue this API token through Core Auth)
MMDASH_CORE_URL=http://core:8080
MMDASH_WORKER_API_TOKEN=
MMDASH_WORKER_ID=mmdash-worker-1
MMDASH_WORKER_LEASE_SECONDS=60
MMDASH_WORKER_POLL_SECONDS=2

# Local development dependencies
POSTGRES_DB=mmdash
POSTGRES_USER=mmdash
POSTGRES_PASSWORD=mmdash
MINIO_ROOT_USER=mmdash
MINIO_ROOT_PASSWORD=change-me
