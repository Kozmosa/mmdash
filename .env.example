# Public entry point
MMDASH_PUBLIC_URL=https://mmdash.com

# Web
WEB_PORT=3000
NEXT_PUBLIC_BFF_BASE_URL=

# Web BFF
BFF_HOST=0.0.0.0
BFF_PORT=3001
BFF_COOKIE_SECRET=replace-with-at-least-32-random-characters
CORE_BASE_URL=http://core:8080

# MCP Gateway
MCP_GATEWAY_HOST=0.0.0.0
MCP_GATEWAY_PORT=3002
MCP_CLI_TOKEN=replace-with-at-least-32-random-characters
MCP_AGENT_TOKEN=replace-with-another-32-random-characters
MCP_CLI_PROJECTS=*
MCP_CLI_TOOLS=*
MCP_AGENT_PROJECTS=*
MCP_AGENT_TOOLS=*
MCP_ALLOWED_HOSTS=mmdash.com,localhost,127.0.0.1
MCP_ALLOWED_ORIGINS=https://mmdash.com,http://localhost:3002
MCP_SESSION_TTL_MS=1800000

# Core and infrastructure
CORE_ADDR=:8080
DATABASE_URL=postgres://mmdash:mmdash@postgres:5432/mmdash?sslmode=disable
OBJECT_STORAGE_ENDPOINT=http://minio:9000
OBJECT_STORAGE_ACCESS_KEY=mmdash
OBJECT_STORAGE_SECRET_KEY=change-me
OBJECT_STORAGE_BUCKET=mmdash

# Local development dependencies
POSTGRES_DB=mmdash
POSTGRES_USER=mmdash
POSTGRES_PASSWORD=mmdash
MINIO_ROOT_USER=mmdash
MINIO_ROOT_PASSWORD=change-me
