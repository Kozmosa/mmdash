# Public entry point
MMDASH_PUBLIC_URL=https://mmdash.moe
CORE_INTERNAL_URL=http://core:8080
MMDASH_URL=https://mmdash.moe
MMDASH_LOG_LEVEL=warn
MMDASH_VERSION=0.1.0

# Web
WEB_PORT=3000
NEXT_PUBLIC_BFF_BASE_URL=

# Web BFF
BFF_HOST=0.0.0.0
BFF_PORT=3001
BFF_COOKIE_SECRET=replace-with-at-least-32-random-characters
CORE_BASE_URL=http://core:8080

# MCP Gateway
MCP_GATEWAY_HOST=0.0.0.0
MCP_GATEWAY_PORT=3002
MCP_CLI_TOKEN=replace-with-at-least-32-random-characters
# 仅本地开发；生产镜像（NODE_ENV=production）拒绝该静态 Token，
# 产品 Agent 必须使用 Core 签发的 Project-scoped Agent Token。
MCP_AGENT_TOKEN=
MCP_CLI_PROJECTS=*
MCP_CLI_TOOLS=*
MCP_AGENT_PROJECTS=*
MCP_AGENT_TOOLS=*
MCP_ALLOWED_HOSTS=mmdash.moe,localhost,127.0.0.1
MCP_ALLOWED_ORIGINS=https://mmdash.moe,http://localhost:3002
MCP_SESSION_TTL_MS=1800000
# Optional Core-issued API token used to persist MCP audit events.
MCP_CORE_AUDIT_TOKEN=

# Core and infrastructure
CORE_ADDR=:8080
CORE_OPENAPI_PATH=contracts/openapi/core.yaml
CORE_SHUTDOWN_TIMEOUT=10s
CORE_STARTUP_TIMEOUT=15s
AUTH_JWT_SECRET=replace-with-at-least-32-random-characters
AUTH_ACCESS_TOKEN_TTL=24h
AUTH_SESSION_TTL=720h
AUTH_DEVICE_AUTHORIZATION_TTL=10m
AUTH_DEVICE_POLL_INTERVAL=5s
# Public MCP endpoint written into Hermes project-access configuration.
AGENT_MCP_GATEWAY_URL=https://mmdash.moe/mcp
# Runtime API outbound policy. Loopback/private destinations are denied by default.
AGENT_RUNTIME_ALLOW_LOOPBACK=false
AGENT_RUNTIME_ALLOW_PRIVATE=false
AGENT_RUNTIME_ALLOWED_PORTS=80,443,8642
AGENT_RUNTIME_CONNECT_TIMEOUT=5s
AGENT_RUNTIME_RESPONSE_HEADER_TIMEOUT=10s
AGENT_RUNTIME_REQUEST_TIMEOUT=30s
AGENT_RUNTIME_MAX_REDIRECTS=3
AGENT_RUNTIME_MAX_RESPONSE_BYTES=4194304
# Dashboard management outbound policy. Enable private ranges only for controlled deployments.
AGENT_MANAGEMENT_ALLOW_LOOPBACK=false
AGENT_MANAGEMENT_ALLOW_PRIVATE=false
AGENT_MANAGEMENT_ALLOWED_PORTS=80,443,9119
AGENT_MANAGEMENT_CONNECT_TIMEOUT=5s
AGENT_MANAGEMENT_RESPONSE_HEADER_TIMEOUT=10s
AGENT_MANAGEMENT_REQUEST_TIMEOUT=30s
AGENT_MANAGEMENT_MINIMUM_INTERVAL=250ms
AGENT_MANAGEMENT_MAX_REDIRECTS=3
AGENT_MANAGEMENT_MAX_RESPONSE_BYTES=4194304
SETTINGS_ENCRYPTION_KEY=development-settings-encryption-key-change-me
# Registered public Notion integration. The redirect URI must exactly match
# the URI configured in Notion; omit it to use MMDASH_PUBLIC_URL plus the path.
NOTION_OAUTH_CLIENT_ID=
NOTION_OAUTH_CLIENT_SECRET=
NOTION_OAUTH_REDIRECT_URI=https://mmdash.moe/api/integrations/notion/oauth/callback
OUTBOX_POLL_INTERVAL=500ms
OUTBOX_EVENT_LEASE=30s
OUTBOX_DELIVERY_LEASE=30s
OUTBOX_RETRY_DELAY=2s
PROGRESS_REMINDER_POLL_INTERVAL=1s
PROGRESS_REMINDER_BATCH_SIZE=20
PROGRESS_REMINDER_LEASE=30s
PROGRESS_REMINDER_RETRY_DELAY=2s
PROGRESS_TRACKING_POLL_INTERVAL=1s
PROGRESS_TRACKING_LEASE=2m
PROGRESS_TRACKING_RETRY_DELAY=30s
MMDASH_PROGRESS_EVALUATOR_MODE=core_agent
PROJECT_INVITATION_EXPIRY_POLL_INTERVAL=30s
PROJECT_INVITATION_EXPIRY_BATCH_SIZE=100
AUTH_BOOTSTRAP_EMAIL=admin@mmdash.local
AUTH_BOOTSTRAP_DISPLAY_NAME=mmdash Admin
AUTH_BOOTSTRAP_PASSWORD=replace-with-at-least-12-characters
DATABASE_URL=postgres://mmdash:mmdash@postgres:5432/mmdash?sslmode=disable
DATABASE_MAX_IDLE_CONNS=5
DATABASE_MAX_OPEN_CONNS=20
DATABASE_CONN_MAX_IDLE_TIME=5m
DATABASE_CONN_MAX_LIFETIME=30m
OBJECT_STORAGE_ENDPOINT=http://minio:9000
OBJECT_STORAGE_PUBLIC_ENDPOINT=https://storage.mmdash.moe
OBJECT_STORAGE_ACCESS_KEY=mmdash
OBJECT_STORAGE_SECRET_KEY=change-me
OBJECT_STORAGE_BUCKET=mmdash
OBJECT_STORAGE_REGION=us-east-1
ARTIFACT_STORAGE_BACKEND=minio
ARTIFACT_LOCAL_STORAGE_ROOT=/var/lib/mmdash/artifacts
ARTIFACT_UPLOAD_MAX_BYTES=10737418240
ARTIFACT_PREVIEW_OUTPUT_MAX_BYTES=4194304
ARTIFACT_MULTIPART_PART_BYTES=16777216
ARTIFACT_MULTIPART_URL_TTL=15m
ARTIFACT_MULTIPART_SESSION_TTL=24h
ARTIFACT_STAGING_TTL=24h
ARTIFACT_STAGING_SWEEP_INTERVAL=5m
# Exact browser origin used for MinIO/S3 CORS; never use "*" in production.
ARTIFACT_WEB_ORIGIN=https://mmdash.moe
REPO_STORAGE_ROOT=/var/lib/mmdash/repos
# Semicolon-separated on Windows, colon-separated on Linux; empty disables Local Git.
REPO_LOCAL_ALLOWED_ROOTS=
REPO_MAX_CONCURRENT_GIT=4
REPO_COMMAND_TIMEOUT=2m
REPO_CLONE_TIMEOUT=15m
REPO_SYNC_POLL_INTERVAL=2s
REPO_SYNC_LEASE=20m
REPO_CHECKOUT_TTL=1h
REPO_MAX_TEXT_BYTES=1048576
REPO_DISCONNECT_GRACE=24h
REPO_ASKPASS_PATH=mmdash-git-askpass

# Python Worker (issue this API token through Core Auth)
MMDASH_CORE_URL=http://core:8080
MMDASH_WORKER_API_TOKEN=
MMDASH_WORKER_ID=mmdash-worker-1
MMDASH_WORKER_LEASE_SECONDS=60
MMDASH_WORKER_POLL_SECONDS=2
MMDASH_PREVIEW_MAX_INPUT_BYTES=134217728
MMDASH_PREVIEW_MAX_IMAGE_PIXELS=40000000
MMDASH_PREVIEW_MAX_PDF_PAGES=1000
MMDASH_PREVIEW_MAX_PDF_TEXT_PAGES=20
MMDASH_PREVIEW_MAX_CSV_ROWS=10000
MMDASH_PREVIEW_MAX_CSV_COLUMNS=256
MMDASH_PREVIEW_MAX_SAMPLE_ROWS=20
MMDASH_PREVIEW_MAX_JSON_BYTES=8388608
MMDASH_PREVIEW_MAX_TEXT_BYTES=2097152
MMDASH_PREVIEW_MAX_TEXT_CHARS=32768
MMDASH_PREVIEW_MAX_SUMMARY_BYTES=65536
MMDASH_PREVIEW_MAX_THUMBNAIL_BYTES=4194304
MMDASH_PREVIEW_THUMBNAIL_DIMENSION=512
MMDASH_PREVIEW_TIMEOUT_SECONDS=60

# Local development dependencies
POSTGRES_DB=mmdash
POSTGRES_USER=mmdash
POSTGRES_PASSWORD=mmdash
MINIO_ROOT_USER=mmdash
MINIO_ROOT_PASSWORD=change-me
